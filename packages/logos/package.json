{
  "name": "@earendil-works/elanor-logos",
  "version": "0.1.0",
  "private": true,
  "description": "Earendil, Pi, Radius, and Lefos logos as SVG files.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./svg/*": "./dist/svg/*",
    "./manifest.json": "./dist/manifest.json",
    "./artwork.json": "./dist/artwork.json"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "tsc -p tsconfig.json --noEmit && pnpm run check:prepare && tsx scripts/check.ts",
    "check:prepare": "pnpm --filter @earendil-works/design-tokens run build:radius",
    "test": "pnpm run check:prepare && vitest run --dir tests"
  },
  "devDependencies": {
    "@earendil-works/design-tokens": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
