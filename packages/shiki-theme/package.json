{
  "name": "@earendil-works/elanor-shiki-theme",
  "version": "0.1.0",
  "description": "A Shiki theme that colors code with Elanor's code syntax tokens.",
  "license": "ISC",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "shiki": "^4.4.3",
    "typescript": "^7.0.2"
  }
}
