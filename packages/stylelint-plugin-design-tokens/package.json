{
  "name": "@earendil-works/stylelint-plugin-design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Stylelint rules for consuming generated DTCG design tokens.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @earendil-works/design-tokens run build:radius",
    "test": "vitest run"
  },
  "peerDependencies": {
    "stylelint": ">=16 <17"
  },
  "dependencies": {
    "minimatch": "^10.2.4",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@earendil-works/design-tokens": "workspace:*",
    "@types/node": "^24.13.3",
    "stylelint": "^16.26.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
