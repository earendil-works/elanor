{
  "name": "@earendil-works/stylelint-plugin-design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Stylelint rules for consuming generated DTCG design tokens.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check": "pnpm run lint && tsc -p tsconfig.json",
    "lint": "oxlint . --max-warnings 0 --report-unused-disable-directives",
    "pretest": "pnpm --filter @earendil-works/design-tokens run build:radius",
    "test": "vitest run"
  },
  "peerDependencies": {
    "stylelint": ">=17 <18"
  },
  "dependencies": {
    "minimatch": "^10.2.6",
    "postcss": "^8.5.29",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@earendil-works/design-tokens": "workspace:*",
    "@types/node": "^24.19.0",
    "stylelint": "^17.15.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
