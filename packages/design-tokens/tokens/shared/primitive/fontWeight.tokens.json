{
  "$schema": "https://designtokens.org/schemas/2025.10/format.json",
  "$description": "Shared primitive font weight scale using standard OpenType weight values.",
  "primitive": {
    "fontWeight": {
      "$type": "fontWeight",
      "100": {
        "$value": 100,
        "$description": "Thin."
      },
      "200": {
        "$value": 200,
        "$description": "Extra light."
      },
      "300": {
        "$value": 300,
        "$description": "Light."
      },
      "400": {
        "$value": 400,
        "$description": "Normal (regular)."
      },
      "450": {
        "$value": 450,
        "$description": "Half a step between 400 and 500. Needs a variable font; static fonts render the nearest weight."
      },
      "500": {
        "$value": 500,
        "$description": "Medium."
      },
      "550": {
        "$value": 550,
        "$description": "Half a step between 500 and 600. Needs a variable font; static fonts render the nearest weight."
      },
      "600": {
        "$value": 600,
        "$description": "Semi-bold."
      },
      "700": {
        "$value": 700,
        "$description": "Bold."
      },
      "800": {
        "$value": 800,
        "$description": "Extra bold."
      },
      "900": {
        "$value": 900,
        "$description": "Black."
      },
      "950": {
        "$value": 950,
        "$description": "Extra black."
      }
    }
  }
}
