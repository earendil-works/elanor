{
  "$schema": "https://designtokens.org/schemas/2025.10/format.json",
  "semantic": {
    "shadow": {
      "$type": "shadow",
      "popup": {
        "$description": "Use to separate floating panels such as menus and dropdowns from the surface beneath them. A soft dark shadow in light mode, a pale glow in dark mode, where a dark shadow wouldn't show.",
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [1, 1, 1],
            "alpha": 0.12
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 24,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      }
    }
  }
}
