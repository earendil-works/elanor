{
  "$schema": "https://designtokens.org/schemas/2025.10/format.json",
  "semantic": {
    "duration": {
      "$type": "duration",
      "motion": {
        "quick": {
          "$value": "{primitive.duration.100}"
        },
        "standard": {
          "$value": "{primitive.duration.150}"
        },
        "navigation": {
          "$value": "{primitive.duration.350}"
        },
        "drawer": {
          "$value": "{primitive.duration.450}"
        },
        "drawerRelease": {
          "$value": "{primitive.duration.400}"
        }
      }
    }
  }
}
