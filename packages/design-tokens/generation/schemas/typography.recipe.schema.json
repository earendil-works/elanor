{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Typography scale recipe",
  "type": "object",
  "required": ["path", "steps", "lineHeight"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^$]+$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 100,
        "multipleOf": 100
      }
    },
    "lineHeight": {
      "type": "object",
      "required": ["anchors", "gridTiers"],
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["fontSizePx", "ratio"],
            "additionalProperties": false,
            "properties": {
              "fontSizePx": {
                "type": "integer",
                "minimum": 1
              },
              "ratio": {
                "type": "number",
                "exclusiveMinimum": 1
              }
            }
          }
        },
        "gridTiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["minFontSizePx", "gridPx"],
            "additionalProperties": false,
            "properties": {
              "minFontSizePx": {
                "type": "integer",
                "minimum": 0
              },
              "gridPx": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
