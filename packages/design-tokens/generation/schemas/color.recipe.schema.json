{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Color scale recipe",
  "type": "object",
  "required": ["path", "steps", "colors"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^$]+$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000,
        "anyOf": [{"enum": [25, 50]}, {"multipleOf": 100}]
      }
    },
    "interactiveSteps": {
      "type": "object",
      "required": ["distance", "states", "lighterFrom", "darkerFrom"],
      "additionalProperties": false,
      "properties": {
        "distance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["hover", "active"]}
        },
        "lighterFrom": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "multipleOf": 100
          }
        },
        "darkerFrom": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "multipleOf": 100
          }
        }
      }
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "A named key color, optionally with a generated scale at the key's hue. With a scale, the key becomes the scale group's $root.",
        "type": "object",
        "required": ["name", "key"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "pattern": "^[^$]+$"},
          "key": {
            "description": "The defining color, in the same shape as a DTCG color value. It must lie within sRGB.",
            "type": "object",
            "required": ["colorSpace", "components"],
            "additionalProperties": false,
            "properties": {
              "colorSpace": {"const": "oklch"},
              "components": {
                "description": "Lightness from 0 to 1, chroma, and hue in degrees.",
                "type": "array",
                "items": [
                  {"type": "number", "minimum": 0, "maximum": 1},
                  {"type": "number", "minimum": 0},
                  {"type": "number", "minimum": 0, "exclusiveMaximum": 360}
                ],
                "minItems": 3,
                "additionalItems": false
              }
            }
          },
          "print": {
            "description": "CMYK builds of the key color as percentages, per print profile.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "integer", "minimum": 0, "maximum": 100}
            }
          },
          "saturation": {
            "type": "object",
            "required": ["min", "max"],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
