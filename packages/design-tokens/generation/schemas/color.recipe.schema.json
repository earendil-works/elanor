{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Color scale recipe",
  "type": "object",
  "required": ["path", "steps", "colors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^$]+$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000,
        "anyOf": [
          { "enum": [25, 50] },
          { "multipleOf": 100 }
        ]
      }
    },
    "interactiveSteps": {
      "type": "object",
      "required": ["distance", "states", "lighterFrom", "darkerFrom"],
      "additionalProperties": false,
      "properties": {
        "distance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["hover", "active"] }
        },
        "lighterFrom": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "multipleOf": 100
          }
        },
        "darkerFrom": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "multipleOf": 100
          }
        }
      }
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "hue", "saturation"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "^[^$]+$" },
          "hue": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
          "brand": {
            "type": "object",
            "required": ["hex"],
            "additionalProperties": false,
            "properties": {
              "hex": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
              "allowHueShift": { "type": "boolean" },
              "cmyk": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "integer", "minimum": 0, "maximum": 100 }
                }
              }
            }
          },
          "saturation": {
            "type": "object",
            "required": ["min", "max"],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
