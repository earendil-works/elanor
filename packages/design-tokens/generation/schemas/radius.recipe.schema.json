{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Border radius scale recipe",
  "type": "object",
  "required": ["path", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^$]+$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 100,
        "multipleOf": 100
      }
    }
  }
}
