{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["generation/**/*.ts", "scripts/**/*.ts", "scripts/**/*.mts", "terrazzo.*.config.ts"]
}
