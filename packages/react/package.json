{
  "name": "@earendil-works/elanor-react",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./elanor.min.css": "./dist/elanor.min.css"
  },
  "scripts": {
    "build": "pnpm run generate:css:check && vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "generate:css": "node scripts/generate-layout-css.mjs",
    "generate:css:check": "node scripts/generate-layout-css.mjs --check",
    "check": "pnpm run lint && pnpm run generate:css:check && pnpm run check:types",
    "check:prepare": "pnpm --filter @earendil-works/elanor-icons-react... run build",
    "check:types": "pnpm run check:prepare && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run lint:oxlint && pnpm run lint:stylelint",
    "lint:oxlint": "oxlint . --max-warnings 0 --report-unused-disable-directives",
    "lint:stylelint": "pnpm run lint:stylelint:prepare && stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:stylelint:prepare": "pnpm --filter @earendil-works/design-tokens run build:radius && pnpm --filter @earendil-works/stylelint-plugin-design-tokens run build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@earendil-works/elanor-icons-react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@earendil-works/design-tokens": "workspace:*",
    "@earendil-works/stylelint-plugin-design-tokens": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stylelint": "^17.15.0",
    "vite": "8.3.1"
  }
}
