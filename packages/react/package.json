{
  "name": "@earendil-works/elanor-react",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": ["dist", "README.md"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "pnpm run check:types && pnpm run lint",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "lint:prepare": "pnpm --filter @earendil-works/design-tokens run build:radius && pnpm --filter @earendil-works/stylelint-plugin-design-tokens run build",
    "lint": "pnpm run lint:prepare && stylelint \"src/**/*.css\" --max-warnings 0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@earendil-works/design-tokens": "workspace:*",
    "@earendil-works/stylelint-plugin-design-tokens": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": "^16.26.1"
  }
}
