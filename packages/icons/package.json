{
  "name": "@earendil-works/elanor-icons",
  "version": "0.1.0",
  "description": "Boiled Material Symbols as SVG files.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "provenance.json",
    "README.md"
  ],
  "exports": {
    "./svg/*": {
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg/*"
    },
    "./LICENSE": "./LICENSE",
    "./NOTICE": "./NOTICE",
    "./metadata.json": "./dist/metadata.json"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "prepack": "pnpm run build",
    "check": "pnpm run lint && tsc -p tsconfig.json --noEmit && tsx scripts/check.ts",
    "lint": "oxlint . --ignore-pattern \"react/**\" --max-warnings 0 --report-unused-disable-directives",
    "test": "vitest run --dir tests",
    "refresh": "tsx scripts/refresh.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
