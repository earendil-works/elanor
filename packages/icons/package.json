{
  "name": "@earendil-works/elanor-icons",
  "version": "0.1.0",
  "description": "Boiled Material Symbols as SVG files.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "provenance.json",
    "README.md"
  ],
  "exports": {
    "./svg/*": {
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg/*"
    },
    "./LICENSE": "./LICENSE",
    "./NOTICE": "./NOTICE"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "prepack": "pnpm run build",
    "check": "tsc -p tsconfig.json --noEmit && tsx scripts/check.ts",
    "test": "vitest run --dir tests",
    "refresh": "tsx scripts/refresh.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
