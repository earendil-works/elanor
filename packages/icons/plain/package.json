{
  "name": "@earendil-works/elanor-icons",
  "version": "0.1.0",
  "description": "Material Symbols as SVG files.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "provenance.json",
    "README.md"
  ],
  "exports": {
    "./svg/*": {
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg/*"
    },
    "./LICENSE": "./LICENSE",
    "./NOTICE": "./NOTICE",
    "./metadata.json": "./dist/metadata.json"
  },
  "scripts": {
    "build": "tsx ../scripts/build.ts plain",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
