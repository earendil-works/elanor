{
  "name": "@earendil-works/elanor-fonts",
  "version": "0.1.0",
  "private": true,
  "description": "Earendil, Commit Mono and Elanor Sans fonts with self-hosted CSS entry points.",
  "license": "OFL-1.1",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "*.css",
    "files",
    "licenses",
    "README.md"
  ],
  "exports": {
    "./earendil.css": "./earendil.css",
    "./commit-mono.css": "./commit-mono.css",
    "./elanor-sans.css": "./elanor-sans.css",
    "./files/*": "./files/*",
    "./licenses/*": "./licenses/*"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run test",
    "lint": "oxlint . --max-warnings 0 --report-unused-disable-directives",
    "test": "node --test tests/*.test.mjs"
  }
}
