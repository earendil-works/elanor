{
  "name": "@earendil-works/elanor-fonts",
  "version": "0.1.0",
  "description": "Simbelle Serif, Simbelle Sans, Simbelle Mono, and DepartureMono fonts with self-hosted CSS entry points.",
  "license": "OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/elanor.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://github.com/earendil-works/elanor/tree/main/packages/fonts#readme",
  "bugs": {
    "url": "https://github.com/earendil-works/elanor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "*.css",
    "files",
    "licenses",
    "README.md"
  ],
  "exports": {
    "./simbelle-serif.css": "./simbelle-serif.css",
    "./simbelle-sans.css": "./simbelle-sans.css",
    "./simbelle-mono.css": "./simbelle-mono.css",
    "./departure-mono.css": "./departure-mono.css",
    "./files/*": "./files/*",
    "./licenses/*": "./licenses/*"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run test",
    "lint": "oxlint . --max-warnings 0 --report-unused-disable-directives",
    "test": "node --test tests/*.test.mjs"
  }
}
