---
// The top navigation's identity: the logo (`logo` in elanor-docs.json, or the brand's symbol) and
// the site's name. Replace with `components.Identity` for anything else. Props: `page` and `config`.
import type {RuntimeConfig} from '../../content/context.ts';
import {SiteIdentity} from '../SiteIdentity.tsx';

interface Props {
  config: RuntimeConfig;
}

const {config} = Astro.props;
---

<SiteIdentity name={config.name} brand={config.brand} logo={config.logo} base={config.base} />
