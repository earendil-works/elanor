---
import {Heading, Text} from '@earendil-works/elanor-react';
import DocsLayout from '../layouts/docs-layout.astro';
import {IconBrowser, iconImportTemplate} from '../components/icon-browser.tsx';
import {highlight} from '../lib/highlight.ts';

const importHtml = await highlight(iconImportTemplate, 'tsx');
---

<DocsLayout title="Icons" current="/icons/">
  {/* Starts the index download with the page instead of after hydration. */}
  <link
    slot="head"
    rel="preload"
    href="/icons/search-index.json"
    as="fetch"
    crossorigin="anonymous"
  />
  <div class="page grid-page">
    <Heading level={1} size={1}>Icons</Heading>
    <Text>Material Symbols with a hand-drawn boil. Select an icon for its React import and SVG.</Text>
    <IconBrowser importHtml={importHtml} client:load />
  </div>
</DocsLayout>
