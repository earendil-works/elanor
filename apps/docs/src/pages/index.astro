---
import {getImage} from 'astro:assets';
import flowerSource from '../assets/home/elanor-flower.png';
import HomeGarden from '../components/home/home-garden.astro';
import {HomePage} from '../components/home/home-page.tsx';
import HomeLayout from '../layouts/home-layout.astro';

const mark = await getImage({src: flowerSource, width: 32, densities: [1, 2, 3], format: 'webp'});
---

<HomeLayout>
  <HomePage
    mark={{
      src: mark.src,
      srcSet: mark.srcSet.attribute,
      width: Number(mark.attributes.width),
      height: Number(mark.attributes.height),
    }}
  >
    <HomeGarden />
  </HomePage>
</HomeLayout>
