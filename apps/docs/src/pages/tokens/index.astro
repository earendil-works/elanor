---
import {Heading, Text} from '@earendil-works/elanor-react';
import {
  TokensOverview,
  tokensUsage,
  type TokenAreaSummary,
} from '../../components/tokens-overview.tsx';
import DocsLayout from '../../layouts/docs-layout.astro';
import {highlight} from '../../lib/highlight.ts';
import {defaultTokenBrand, tokenAreaCounts, tokenAreaHref, tokenAreas} from '../../lib/token-pages.ts';

const counts = await tokenAreaCounts(defaultTokenBrand);
const areas: TokenAreaSummary[] = tokenAreas.map((area) => ({
  ...area,
  href: tokenAreaHref(defaultTokenBrand, area.id),
  count: counts.get(area.id) ?? 0,
}));
const usageHtml = await highlight(tokensUsage, 'css');
---

<DocsLayout title="Design tokens" current="/tokens/">
  <div class="page grid-page">
    <Heading level={1} size={1}>Design tokens</Heading>
    <Text>
      Named values for color, type, space, shape, and motion. Use semantic tokens in components;
      primitives are the raw values behind them.
    </Text>
    <TokensOverview areas={areas} usageHtml={usageHtml} />
  </div>
</DocsLayout>

<script>
  import '../../scripts/copy-buttons.ts';
</script>
