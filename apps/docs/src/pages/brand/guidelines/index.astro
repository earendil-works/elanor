---
import {getEntry, render} from 'astro:content';
import DocsLayout from '../../../layouts/docs-layout.astro';

const entry = await getEntry('guidelines', 'brand-guidelines');
if (!entry) throw new Error('Missing brand guidelines');
const {Content} = await render(entry);
---

<DocsLayout title="Brand guidelines" current="/brand/guidelines/">
  <article class="prose">
    <Content />
  </article>
</DocsLayout>
