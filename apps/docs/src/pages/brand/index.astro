---
import {readFile} from 'node:fs/promises';
import {relative, resolve} from 'node:path';
import {getEntry} from 'astro:content';
import {Heading, Link, Text} from '@earendil-works/elanor-react';
import DocsLayout from '../../layouts/docs-layout.astro';
import {BrandLogos} from '../../components/brand-logos.tsx';
import {HeadSnippet} from '../../components/head-snippet.tsx';
import {type LogoManifest, logosDist, logosGuidelines} from '../../lib/packages.ts';

const manifest = JSON.parse(await readFile(resolve(logosDist, 'manifest.json'), 'utf8')) as LogoManifest;
const headTags = new Map(
  await Promise.all(
    manifest.brands.map(async (brand) => [brand.id, brand.favicons?.html ? await readFile(resolve(logosDist, brand.favicons.html), 'utf8') : undefined] as const),
  ),
);

const guidelines = await getEntry('guidelines', 'brand-guidelines');
if (!guidelines?.rendered) throw new Error('Missing brand guidelines; build @earendil-works/elanor-logos first');
// The guidelines are written for the press kit: drop their title, nest their sections under this page's
// heading, and load their images, which are relative to the document, from the logo package.
const guidelinesImages = `/api/logos/${relative(logosDist, logosGuidelines)}/`;
const guidelinesHtml = guidelines.rendered.html
  .replace(/<h1[^>]*>[\s\S]*?<\/h1>/, '')
  .replace(/<(\/?)h2\b/g, '<$1h3')
  .replace(/(<img [^>]*src=")(?![a-z]+:|\/)/g, `$1${guidelinesImages}`);
---

<DocsLayout title="Logos" current="/brand/" wide>
  <div class="page grid-page">
    <Heading level={1} size={1}>Logos</Heading>
    <Text>
      Use the supplied artwork unchanged, with one grid unit of clear space around it. See the <Link href="#guidelines">brand guidelines</Link>.
    </Text>
    {
      manifest.brands.map((brand) => {
        const tags = headTags.get(brand.id);
        return (
          <BrandLogos brand={brand} pressKit={manifest.pressKits?.[brand.id]}>
            {tags ? <HeadSnippet client:visible code={tags} /> : null}
          </BrandLogos>
        );
      })
    }
    <section aria-labelledby="guidelines">
      <Heading level={2} size={2} id="guidelines">Brand guidelines</Heading>
      <article class="prose" set:html={guidelinesHtml} />
    </section>
  </div>
</DocsLayout>
