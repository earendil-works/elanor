---
import {readFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import DocsLayout from '../../layouts/docs-layout.astro';
import {BrandContent} from '../../components/brand-logos.tsx';
import {loadGuidelines} from '../../lib/api.ts';
import {type LogoManifest, logosDist} from '../../lib/packages.ts';

const manifest = JSON.parse(await readFile(resolve(logosDist, 'manifest.json'), 'utf8')) as LogoManifest;
const headTags = new Map(
  await Promise.all(
    manifest.brands.map(async (brand) => [brand.id, brand.favicons?.html ? await readFile(resolve(logosDist, brand.favicons.html), 'utf8') : undefined] as const),
  ),
);

const brands = manifest.brands.map((brand) => ({
  brand,
  pressKit: manifest.pressKits?.[brand.id],
  headTags: headTags.get(brand.id),
}));

// The company guidelines as data, composed under this page's own heading.
const guidelines = await loadGuidelines();
---

<DocsLayout title="Logos" current="/brand/" wide>
  <BrandContent brands={brands} client:load>
    <article class="prose">
      <Fragment set:html={guidelines.intro.html} />
      {
        guidelines.sections.map((section) => (
          <>
            <h3 id={section.id}>{section.title}</h3>
            <Fragment set:html={section.html} />
            {section.images.map((image) => (
              <img src={image.url} alt={image.alt} width={image.width} />
            ))}
          </>
        ))
      }
    </article>
  </BrandContent>
</DocsLayout>
