---
import {getCollection, render, type CollectionEntry} from 'astro:content';
import ApiReference from '../../components/api-reference.astro';
import Demo from '../../components/demo.astro';
import PageTitle from '../../components/page-title.astro';
import DocsLayout from '../../layouts/docs-layout.astro';
import {componentName} from '../../lib/component-name.ts';

interface Props {
  entry: CollectionEntry<'components'>;
}

export async function getStaticPaths() {
  const entries = await getCollection('components');

  return entries.map((entry) => ({
    params: {component: entry.id},
    props: {entry},
  }));
}

const {entry} = Astro.props;
const {Content} = await render(entry);
---

<DocsLayout
  title={componentName(entry.id)}
  current={`/components/${entry.id}/`}
  markdown={`/components/${entry.id}.md`}
>
  <Content components={{Demo, h1: PageTitle}} />
  <ApiReference page={entry.id} body={entry.body ?? ''} />
</DocsLayout>
