---
import '../styles/global.css';
import '@earendil-works/design-tokens/radius.css';
import '@earendil-works/elanor-react/elanor.min.css';
import '../styles/docs.css';
import '../styles/view-transition.css';
import '@earendil-works/elanor-fonts/mallos-serif.css';
import '@earendil-works/elanor-fonts/commit-mono.css';
import {ClientRouter} from 'astro:transitions';
import {pageScriptsBase} from '../../plugins/page-scripts.ts';
import ColorSchemeScript from '../components/color-scheme-script.astro';
import SiteHead from '../components/site-head.astro';
import {DocsHeader} from '../components/docs-header.tsx';
import {DocsContainer} from '../components/docs-layout-parts.tsx';
import {DocsSideNavigation} from '../components/docs-navigation.tsx';
import {DocsSearchDialog} from '../components/docs-search.tsx';
import {SkipLink} from '../components/skip-link.tsx';
import {currentSection, docsNavigation, hasSideNavigation} from '../lib/docs-navigation.ts';
import {siteMark} from '../lib/site-mark.ts';

interface Props {
  title: string;
  /** Path of the current page, used to mark it in the navigation. */
  current: string;
  /** Markdown version of the page, advertised to agents in the head. */
  markdown?: string;
}

const {title, current, markdown} = Astro.props;
const mark = await siteMark();
const sections = await docsNavigation(current);
const section = currentSection(sections, current);
// The Layout demo supplies the page's single main landmark.
const ContentTag = current === '/components/layout/' ? 'div' : 'main';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <SiteHead title={title} />
    <ColorSchemeScript />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="docs-layout">
    <SkipLink />
    {/* The client router swaps these regions (`scripts/docs-swap.ts`). */}
    <div data-docs-swap="header">
      <DocsHeader sections={sections} current={current} currentSection={section} mark={mark} />
    </div>
    <div data-docs-swap="navigation">
      {
        hasSideNavigation(section) && (
          <DocsSideNavigation section={section} current={current} />
        )
      }
    </div>
    {/* Blocking, so the navigation's restored state is there before the first paint. */}
    <script is:inline src={`${pageScriptsBase}navigation-behaviors.js`}></script>
    <ContentTag id="main" tabindex="-1" class="docs-main" data-docs-swap="content">
      <DocsContainer className="docs-content">
        <slot />
      </DocsContainer>
    </ContentTag>
    {/* Opened by the side navigation's search and the top navigation's search button. */}
    <div data-docs-swap="search">
      <DocsSearchDialog />
    </div>
    <script is:inline type="module" src={`${pageScriptsBase}page-behaviors.js`}></script>
  </body>
</html>

<script>
  import '../scripts/color-scheme.ts';
  import '../scripts/docs-swap.ts';
</script>
