---
import '@earendil-works/design-tokens/radius.css';
import '../styles/docs.css';
import '@earendil-works/elanor-fonts/earendil.css';
import '@earendil-works/elanor-fonts/commit-mono.css';
import {getCollection} from 'astro:content';
import {ClientRouter} from 'astro:transitions';
import {DocsSideNavigation, type DocsNavigationSection} from '../components/docs-side-navigation.tsx';

interface Props {
  title: string;
  /** Path of the current page, used to mark it in the navigation. */
  current: string;
  /** Pages with their own layout, such as grids, use the full content width. */
  wide?: boolean;
}

const {title, current, wide = false} = Astro.props;
// The Layout demo supplies the page's single main landmark.
const ContentTag = current === '/components/layout/' ? 'div' : 'main';
const widePreview = [
  '/components/layout/',
  '/components/grid/',
  '/components/container/',
  '/components/sidebar/',
].includes(current);
const entries = await getCollection('components');

function componentName(component: string): string {
  return component
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
}

const sections: DocsNavigationSection[] = [
  {
    label: 'Brand',
    links: [{href: '/brand/', label: 'Logos'}],
  },
  {label: 'Foundations', links: [{href: '/icons/', label: 'Icons'}]},
  {
    label: 'Components',
    links: entries
      .map((entry) => entry.id)
      .sort()
      .map((id) => ({href: `/components/${id}/`, label: componentName(id)})),
  },
];
---

<!doctype html>
<html lang="en" data-color-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <aside>
      <div data-docs-swap="navigation">
        <DocsSideNavigation sections={sections} current={current} />
      </div>
    </aside>
    <ContentTag data-docs-swap="content">
      <div class:list={[wide ? 'wide' : 'preview']} data-wide={widePreview ? '' : undefined}>
        <slot />
      </div>
    </ContentTag>
  </body>
</html>


<script>
  import '../scripts/docs-swap.ts';
</script>
