---
import '@earendil-works/design-tokens/radius.css';
import '@earendil-works/elanor-react/elanor.min.css';
import '../styles/docs.css';
import '@earendil-works/elanor-fonts/earendil.css';
import '@earendil-works/elanor-fonts/commit-mono.css';
import {getCollection} from 'astro:content';
import {ClientRouter} from 'astro:transitions';
import ColorSchemeScript from '../components/color-scheme-script.astro';
import {ColorSchemeToggle} from '../components/color-scheme-toggle.tsx';
import {DocsSideNavigation, type DocsNavigationSection} from '../components/docs-side-navigation.tsx';
import {DocsMobileNavigation} from '../components/docs-mobile-navigation.tsx';
import {componentName} from '../lib/component-name.ts';

interface Props {
  title: string;
  /** Path of the current page, used to mark it in the navigation. */
  current: string;
  /** Pages with their own layout, such as grids, use the full content width. */
  wide?: boolean;
  /** Markdown version of the page, advertised to agents in the head. */
  markdown?: string;
}

const {title, current, wide = false, markdown} = Astro.props;
// The Layout demo supplies the page's single main landmark.
const ContentTag = current === '/components/layout/' ? 'div' : 'main';
const widePreview = [
  '/components/layout/',
  '/components/grid/',
  '/components/container/',
  '/components/sidebar/',
].includes(current);
const entries = await getCollection('components');

const sections: DocsNavigationSection[] = [
  {
    label: 'Brand',
    links: [{href: '/brand/', label: 'Logos'}],
  },
  {label: 'Foundations', links: [{href: '/icons/', label: 'Icons'}]},
  {
    label: 'Components',
    links: entries
      .map((entry) => entry.id)
      .sort()
      .map((id) => ({href: `/components/${id}/`, label: componentName(id)})),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ColorSchemeScript />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <ClientRouter />
  </head>
  <body class="docs-layout">
    <div data-docs-swap="mobile-navigation">
      <DocsMobileNavigation sections={sections} current={current} client:load>
        {/* A slot stays static HTML, so the color scheme script owns its state without hydration. */}
        <ColorSchemeToggle slot="actions" />
      </DocsMobileNavigation>
    </div>
    <aside>
      <div class="docs-aside-actions">
        <ColorSchemeToggle />
      </div>
      <div data-docs-swap="navigation">
        <DocsSideNavigation sections={sections} current={current} />
      </div>
    </aside>
    <ContentTag data-docs-swap="content">
      <div class:list={[wide ? 'wide' : 'preview']} data-wide={widePreview ? '' : undefined}>
        <slot />
      </div>
    </ContentTag>
  </body>
</html>


<script>
  import '../scripts/color-scheme.ts';
  import '../scripts/docs-swap.ts';
</script>
