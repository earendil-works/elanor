---
import '@earendil-works/design-tokens/radius.css';
import '../styles/docs.css';
import '../styles/fonts.css';
import {getCollection} from 'astro:content';
import {ClientRouter} from 'astro:transitions';
import type {DocsNavigationSection} from '../components/docs-side-navigation.tsx';
import {DocsNavigationSurfacePreview} from '../components/surface-previews.tsx';

interface Props {
  title: string;
  /** Path of the current page, used to mark it in the navigation. */
  current: string;
  /** Pages with their own layout, such as grids, use the full content width. */
  wide?: boolean;
}

const {title, current, wide = false} = Astro.props;
// The AppLayout demo supplies its own main landmark.
const ContentTag = current === '/components/app-layout/' ? 'div' : 'main';
const entries = await getCollection('components');

function componentName(component: string): string {
  return component
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
}

const sections: DocsNavigationSection[] = [
  {
    label: 'Brand',
    links: [{href: '/brand/', label: 'Logos'}],
  },
  {label: 'Foundations', links: [{href: '/icons/', label: 'Icons'}]},
  {
    label: 'Components',
    links: entries
      .map((entry) => entry.id)
      .sort()
      .map((id) => ({href: `/components/${id}/`, label: componentName(id)})),
  },
];
---

<!doctype html>
<html lang="en" data-color-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <script is:inline>
      // Restore the docs preference before React appearance bridges hydrate.
      // ?strokes=pencil or ?strokes=plain in the URL sets it, for sharing links.
      const requested = new URLSearchParams(location.search).get('strokes');
      if (requested === 'pencil' || requested === 'plain') localStorage.setItem('elanor-docs-strokes', requested);
      if (localStorage.getItem('elanor-docs-strokes') === 'pencil') document.documentElement.dataset.strokes = 'pencil';
    </script>
    <ClientRouter />
  </head>
  <body>
    <aside>
      <div data-docs-swap="navigation" class="navigation">
        <DocsNavigationSurfacePreview sections={sections} current={current} client:load />
      </div>
    </aside>
    <ContentTag data-docs-swap="content">
      <div class:list={[wide ? 'wide' : 'preview']}>
        <slot />
      </div>
    </ContentTag>
  </body>
</html>


<script>
  import '../scripts/docs-swap.ts';
</script>
