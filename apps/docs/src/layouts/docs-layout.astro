---
import '@earendil-works/design-tokens/radius.css';
import '@earendil-works/elanor-react/elanor.min.css';
import '../styles/docs.css';
import '../styles/view-transition.css';
import '@earendil-works/elanor-fonts/earendil.css';
import '@earendil-works/elanor-fonts/commit-mono.css';
import {ClientRouter} from 'astro:transitions';
import ColorSchemeScript from '../components/color-scheme-script.astro';
import {ColorSchemeToggle} from '../components/color-scheme-toggle.tsx';
import {
  DocsSideNavigation,
  type DocsNavigationGroup,
  type DocsNavigationLink,
} from '../components/docs-side-navigation.tsx';
import {DocsMobileNavigation} from '../components/docs-mobile-navigation.tsx';
import {SiteIdentity} from '../components/site-identity.tsx';
import {componentGroups} from '../lib/component-groups.ts';
import {componentName} from '../lib/component-name.ts';
import {siteMark} from '../lib/site-mark.ts';
import {defaultTokenBrand, tokenAreaHref, tokenAreas} from '../lib/token-pages.ts';

interface Props {
  title: string;
  /** Path of the current page, used to mark it in the navigation. */
  current: string;
  /** Pages with their own layout, such as grids, use the full content width. */
  wide?: boolean;
  /** Markdown version of the page, advertised to agents in the head. */
  markdown?: string;
}

const {title, current, wide = false, markdown} = Astro.props;
const mark = await siteMark();
// The Layout demo supplies the page's single main landmark.
const ContentTag = current === '/components/layout/' ? 'div' : 'main';
const widePreview = [
  '/components/layout/',
  '/components/grid/',
  '/components/container/',
  '/components/sidebar/',
].includes(current);
// Token links stay on the brand of the current token page.
const tokenBrand = /^\/tokens\/([^/]+)\//.exec(current)?.[1] ?? defaultTokenBrand;
const link = (href: string, label: string): DocsNavigationLink => ({type: 'link', href, label});
const groups: DocsNavigationGroup[] = [
  {label: 'Brand', items: [link('/brand/', 'Logos')]},
  {label: 'Foundations', items: [link('/fonts/', 'Fonts'), link('/icons/', 'Icons')]},
  {
    label: 'Tokens',
    items: [
      link('/tokens/', 'Overview'),
      ...tokenAreas.map((area) => link(tokenAreaHref(tokenBrand, area.id), area.label)),
    ],
  },
  {
    label: 'Components',
    items: [
      link('/components/', 'Overview'),
      ...(await componentGroups()).map((group) => ({
        type: 'section' as const,
        id: group.category,
        label: group.label,
        links: group.entries.map((entry) =>
          link(`/components/${entry.id}/`, componentName(entry.id)),
        ),
      })),
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ColorSchemeScript />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <ClientRouter />
  </head>
  <body class="docs-layout">
    <div data-docs-swap="mobile-navigation">
      <DocsMobileNavigation groups={groups} current={current} mark={mark} client:load>
        {/* A slot stays static HTML, so the color scheme script owns its state without hydration. */}
        <ColorSchemeToggle slot="actions" />
      </DocsMobileNavigation>
    </div>
    <aside>
      <div class="docs-aside-actions">
        {/* A full load: the homepage has its own layout without the client router. */}
        <SiteIdentity mark={mark} data-astro-reload />
        <ColorSchemeToggle />
      </div>
      <div data-docs-swap="navigation">
        {/* Persisted, so opened sections stay open across client-side navigation. */}
        <DocsSideNavigation
          groups={groups}
          current={current}
          client:load
          transition:persist="docs-side-navigation"
        />
      </div>
    </aside>
    <ContentTag data-docs-swap="content">
      <div class:list={[wide ? 'wide' : 'preview']} data-wide={widePreview ? '' : undefined}>
        <slot />
      </div>
    </ContentTag>
  </body>
</html>


<script>
  import '../scripts/color-scheme.ts';
  import '../scripts/docs-swap.ts';
  import '../scripts/reveal-current-link.ts';
</script>
