---
import {getImage, Picture} from 'astro:assets';
import beeSource from '../../assets/home/bee-watercolor.png';
import flowerSource from '../../assets/home/elanor-flower.png';
import fireflySource from '../../assets/home/firefly-watercolor.png';
import Courier from './courier.astro';
import {COURIERS} from './couriers.ts';
import './garden.css';

// Insects render at most ~53 CSS px wide; 240 px covers 3x displays and zoom.
const [bee, firefly, aura] = await Promise.all([
  getImage({src: beeSource, width: 240, format: 'webp'}),
  getImage({src: fireflySource, width: 240, format: 'webp'}),
  // Blurred by 22 px in dark mode, so a small copy is indistinguishable.
  getImage({src: flowerSource, width: 320, format: 'webp'}),
]);

// The flower is 72% of the garden: up to 518 px, 612 px on very wide screens,
// and 425 px or 72vw on small screens (see garden.css).
const FLOWER_SIZES = '(max-width: 700px) min(72vw, 425px), (min-width: 1700px) 612px, 518px';
// Up to the painting's full 1254 px. A literal: reading properties of the imported image
// would make Astro ship the 1.6 MB original alongside the optimized copies.
const FLOWER_WIDTHS = [400, 600, 800, 1000, 1254];
---

<script is:inline>
  // Decides before the garden is parsed whether the intro plays. It plays on a new visit
  // or a reload (`?intro` forces it), but not when arriving from another docs page or via
  // back/forward, and never with reduced motion. A safety timeout drops it if it stalls.
  (() => {
    const root = document.documentElement;
    let play = true;
    try {
      const navigation = performance.getEntriesByType('navigation')[0];
      const type = navigation && navigation.type;
      if (type === 'back_forward') play = false;
      else if (type !== 'reload' && document.referrer) {
        const referrer = new URL(document.referrer);
        if (referrer.origin === location.origin && referrer.pathname !== location.pathname) {
          play = false;
        }
      }
    } catch {}
    if (new URLSearchParams(location.search).has('intro')) play = true;
    if (play && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('intro');
      window.elanorIntro = setTimeout(() => root.classList.remove('intro', 'intro-settling'), 8000);
    }
  })();
</script>

<nav class="garden" aria-label="Design system resources">
  <div class="flower-art">
    <div class="flower-damp" aria-hidden="true"></div>
    <img
      class="flower-aura"
      src={aura.src}
      width={aura.attributes.width}
      height={aura.attributes.height}
      alt=""
      decoding="async"
      draggable="false"
    />
    <Picture
      src={flowerSource}
      class="flower-reference"
      alt=""
      formats={['avif']}
      fallbackFormat="webp"
      widths={FLOWER_WIDTHS}
      sizes={FLOWER_SIZES}
      loading="eager"
      fetchpriority="high"
      draggable="false"
    />
    <div class="center-light" aria-hidden="true"></div>
    <canvas class="pollen-canvas" aria-hidden="true"></canvas>
  </div>
  {
    COURIERS.map((courier, index) => (
      <Courier {...courier} index={index} beeSrc={bee.src} fireflySrc={firefly.src} />
    ))
  }
</nav>

<script>
  import {plantGarden} from './garden/index.ts';

  plantGarden();
</script>
