---
import {readFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {Heading, Link, Text} from '@earendil-works/elanor-react';
import {BrandLogos} from './brand-logos.tsx';
import {HeadSnippet} from './head-snippet.tsx';
import {highlight} from '../lib/highlight.ts';
import {loadGuidelines} from '../lib/api.ts';
import {type LogoManifest, logosDist} from '../lib/packages.ts';

const manifest = JSON.parse(await readFile(resolve(logosDist, 'manifest.json'), 'utf8')) as LogoManifest;
const headTags = new Map(
  await Promise.all(
    manifest.brands.map(async (brand) => {
      const code = brand.favicons?.html ? await readFile(resolve(logosDist, brand.favicons.html), 'utf8') : undefined;
      return [brand.id, code ? {code, lines: await highlight(code.trimEnd(), 'html')} : undefined] as const;
    }),
  ),
);

// The company guidelines as data, composed under this page's own heading.
const guidelines = await loadGuidelines();
---

  <div class="page grid-page">
    <Heading level={1} size={1}>Brand</Heading>
    <Text>
      Use the supplied artwork unchanged, with one grid unit of clear space around it. Do not use these assets to
      suggest sponsorship, endorsement, or an affiliation with Earendil or any of its products that does not exist.
      See the <Link href="#guidelines">brand guidelines</Link>.
    </Text>
    {
      manifest.brands.map((brand) => {
        const tags = headTags.get(brand.id);
        return (
          <BrandLogos brand={brand} pressKit={manifest.pressKits?.[brand.id]}>
            {tags ? <HeadSnippet code={tags.code} lines={tags.lines} /> : null}
          </BrandLogos>
        );
      })
    }
    <section aria-labelledby="guidelines">
      <Heading level={2} size={4} id="guidelines">Brand guidelines</Heading>
      <article class="prose">
        <Fragment set:html={guidelines.intro.html} />
        {
          guidelines.sections.map((section) => (
            <>
              <h3 id={section.id}>{section.title}</h3>
              <Fragment set:html={section.html} />
              {section.images.map((image) => (
                <img src={image.url} alt={image.alt} width={image.width} />
              ))}
            </>
          ))
        }
      </article>
    </section>
  </div>
