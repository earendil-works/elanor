---
import {Separator} from '@earendil-works/elanor-react';
import {DocsGrid, DocsProse} from './docs-layout-parts.tsx';
import {DocsPageHeader} from './docs-page-header.tsx';
import {
  DocsTableOfContents,
  DocsTableOfContentsMenu,
  type DocsTocEntry,
} from './docs-table-of-contents.tsx';

interface Props {
  title: string;
  /** Site-relative path of the page's Markdown version, copied by "Copy page". */
  markdown?: string;
  /** When the page last changed, as an ISO 8601 date. */
  lastUpdated?: string | undefined;
  /** The page's sections, for its table of contents. */
  toc: readonly DocsTocEntry[];
}

// A page's long-form content on the content grid: its title, a table of contents, and the
// content in `Prose`. On wide screens, the article takes nine columns and the table of contents
// the other three.
const {title, markdown, lastUpdated, toc} = Astro.props;
const column = toc.length > 0;
---

<DocsGrid className="docs-grid">
  <article class="docs-article" data-toc={column ? '' : undefined}>
    <DocsPageHeader title={title} markdown={markdown} lastUpdated={lastUpdated} />
    <Separator className="docs-page-separator" />
    {toc.length > 0 && <DocsTableOfContentsMenu entries={toc} />}
    <DocsProse>
      <slot />
    </DocsProse>
  </article>
  {column && <DocsTableOfContents entries={toc} />}
</DocsGrid>
