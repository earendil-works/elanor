{
  "name": "@earendil-works/elanor-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "pnpm run lint && pnpm run check:types",
    "check:prepare": "pnpm --filter @earendil-works/elanor-icons-boiled-react... --filter @earendil-works/elanor-shiki-theme run build",
    "check:types": "pnpm run check:prepare && astro check",
    "lint": "pnpm run lint:oxlint && pnpm run lint:stylelint",
    "lint:oxlint": "oxlint . --max-warnings 0 --report-unused-disable-directives",
    "lint:stylelint": "pnpm run lint:stylelint:prepare && stylelint \"src/**/*.{css,astro}\" --max-warnings 0",
    "lint:stylelint:prepare": "pnpm --filter @earendil-works/design-tokens run build:radius && pnpm --filter @earendil-works/stylelint-plugin-design-tokens run build"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@earendil-works/design-tokens": "workspace:*",
    "@earendil-works/elanor-fonts": "workspace:*",
    "@earendil-works/elanor-icons-boiled": "workspace:*",
    "@earendil-works/elanor-icons-boiled-react": "workspace:*",
    "@earendil-works/elanor-logos": "workspace:*",
    "@earendil-works/elanor-react": "workspace:*",
    "@earendil-works/elanor-shiki-theme": "workspace:*",
    "@sentry/astro": "11.2.0",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@earendil-works/stylelint-plugin-design-tokens": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "magic-string": "^1.4.2",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
