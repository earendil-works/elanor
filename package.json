{
  "name": "elanor-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "dev": "pnpm --filter @earendil-works/elanor-docs dev",
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "check": "pnpm -r --workspace-concurrency=1 --if-present run check",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "docs:lint": "pnpm --filter @earendil-works/elanor-docs run lint",
    "react:lint": "pnpm --filter @earendil-works/elanor-react run lint",
    "tokens:clean": "pnpm --filter @earendil-works/design-tokens run clean",
    "tokens:generate": "pnpm --filter @earendil-works/design-tokens run generate",
    "tokens:generate:check": "pnpm --filter @earendil-works/design-tokens run generate:check",
    "tokens:build": "pnpm --filter @earendil-works/design-tokens run build",
    "tokens:build:radius": "pnpm --filter @earendil-works/design-tokens run build:radius",
    "tokens:build:pi": "pnpm --filter @earendil-works/design-tokens run build:pi",
    "tokens:build:earendil": "pnpm --filter @earendil-works/design-tokens run build:earendil",
    "tokens:build:lefos": "pnpm --filter @earendil-works/design-tokens run build:lefos",
    "tokens:check": "pnpm --filter @earendil-works/design-tokens run check",
    "tokens:check:types": "pnpm --filter @earendil-works/design-tokens run check:types",
    "tokens:check:schema": "pnpm --filter @earendil-works/design-tokens run check:schema",
    "tokens:check:contrast": "pnpm --filter @earendil-works/design-tokens run check:contrast",
    "tokens:check:terrazzo": "pnpm --filter @earendil-works/design-tokens run check:terrazzo",
    "tokens:schemas:update": "pnpm --filter @earendil-works/design-tokens run schemas:update",
    "stylelint:clean": "pnpm --filter @earendil-works/stylelint-plugin-design-tokens run clean",
    "stylelint:build": "pnpm --filter @earendil-works/stylelint-plugin-design-tokens run build",
    "stylelint:test": "pnpm --filter @earendil-works/stylelint-plugin-design-tokens run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
